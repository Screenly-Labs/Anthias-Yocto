# Development PKI - generated by scripts/make-dev-pki.sh, never committed.
# This repo is public; the CA key is the root of trust for every device
# flashed with a non-production image, and the certs are derived from it,
# so committing stale certs alongside a regenerated key would just break.
recipes-core/rauc-bundles/files/*.pem
recipes-core/rauc-bundles/files/*.srl
recipes-core/rauc/files/ca.cert.pem
recipes-core/rauc/files/*.srl
